# ─── Project-specific ──────────────────────────────────────────────────────

# Dados — apenas estrutura de pastas versionada (.gitkeep)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Modelos e artefatos treinados
models/artifacts/*
models/onnx/*
models/bert_experiment/
!models/artifacts/.gitkeep
!models/onnx/.gitkeep
models/promoted_model.json

# Métricas geradas em runtime
metrics/*.json
!metrics/.gitkeep
# Artefatos de comparação curados: servidos pela API (/demo/*) e embutidos na
# imagem Docker (COPY no Dockerfile), portanto versionados propositalmente.
!metrics/experiment_comparison.json
!metrics/latency_comparison.json

