{
  "info": {
    "name": "Triage Classifier API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://localhost:8000" }],
  "item": [
    {
      "name": "Root",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Predict — Urgente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Paciente relata dor toracica intensa e subita, irradiando para o braco esquerdo.\"\n}"
        },
        "url": "{{base_url}}/predict"
      }
    },
    {
      "name": "Predict — Normal",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Consulta de rotina, paciente assintomatico.\"\n}"
        },
        "url": "{{base_url}}/predict"
      }
    },
    {
      "name": "Metrics (Prometheus)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/metrics"
      }
    }
  ]
}
