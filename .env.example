# Onde o serving (src/serving/model_loader.py) procura os artefatos treinados.
# Hiperparâmetros de treino (features, modelo, split) ficam em config/config.yaml,
# não aqui — não são algo que se muda por ambiente de deploy.
MODEL_ARTIFACTS_PATH=models/artifacts
MODEL_ONNX_PATH=models/onnx

# Backend de inferência usado pela API: "sklearn" ou "onnx"
MODEL_BACKEND=sklearn

# API serving
API_HOST=0.0.0.0
API_PORT=8000

# Prometheus/Grafana (usados pelo docker-compose de monitoramento)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Airflow (usados pelo docker-compose.airflow.yml)
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
