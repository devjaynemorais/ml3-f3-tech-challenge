# Onde o serving (src/serving/model_loader.py) procura os artefatos treinados.
# Hiperparâmetros de treino (features, modelo, split) ficam em config/config.yaml,
# não aqui — não são algo que se muda por ambiente de deploy.
MODEL_ARTIFACTS_PATH=models/artifacts
MODEL_ONNX_PATH=models/onnx

# Backend de inferência usado pela API: "sklearn" ou "onnx"
MODEL_BACKEND=sklearn

# API serving
API_HOST=0.0.0.0
API_PORT=8000

# Prometheus/Grafana (usados pelo docker-compose de monitoramento)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# MLflow (tracking de experimentos do treino)
MLFLOW_PORT=5000
# Local (make train fora do Docker) aponta pro container via porta publicada;
# dentro do compose, o serviço "train" sobrescreve para http://mlflow:5000.
MLFLOW_TRACKING_URI=http://localhost:5000

# Dispositivo de treino: "auto" (padrao) | "cpu" | "cuda"/"gpu"
# scripts/finetune_bert.py (baseline BERT) sempre respeita a variavel: "auto"
# detecta GPU automaticamente, "cpu"/"cuda" forcam um dos dois.
# model.type=gradient_boosting (make train / make experiments) só troca de
# algoritmo com um pedido EXPLICITO de "cuda"/"gpu" — nesse caso troca o
# GradientBoostingClassifier (sklearn, sem GPU) por XGBoost com device=cuda.
# "auto"/vazio nunca ativa isso sozinho, mesmo com GPU disponível na máquina:
# é uma troca de algoritmo, não só de velocidade, e não deve depender de qual
# máquina roda o treino. Os outros model.type (logistic_regression, etc.) e
# TF-IDF/embeddings não têm equivalente GPU nativo no Windows e ignoram a
# variável, só logando um aviso se "cuda"/"gpu" for pedido. "cuda" falha com
# erro claro se nenhuma GPU NVIDIA for detectada (via nvidia-smi).
TRAINING_DEVICE=auto

# Airflow + serviço "train" do docker-compose principal rodam sob este UID, para
# que os artefatos gravados nos volumes compartilhados (data/models/metrics)
# fiquem co-pertencentes e reescrevíveis por ambos os stacks. Se você também roda
# `make train`/`make dataset` LOCALMENTE (fora do Docker), defina AIRFLOW_UID com
# o seu UID de host (`id -u`, ex.: 1000) para que os arquivos locais e os do
# container tenham o mesmo dono e não haja conflito de permissão.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
